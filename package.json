{
  "name": "fridgemate",
  "description": "A local-first fridge and pantry tracker with expiry alerts, recipe recommendations, and OCR-based ingredient import.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file=.env server/src/index.js",
    "dev:worker": "wrangler dev",
    "lint": "eslint .",
    "build": "vite build",
    "postbuild": "node scripts/copy-tesseract-assets.js && node scripts/generate-adsense-assets.js && node scripts/generate-seo-pages.js && node scripts/verify-seo-output.js",
    "preview": "vite preview",
    "verify:public-deployment": "node scripts/verify-public-deployment.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "server": "node server/src/index.js",
    "start": "node server/src/index.js",
    "worker:deploy": "wrangler deploy",
    "worker:dry-run": "wrangler deploy --dry-run",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "backup:preflight": "node --env-file=.env scripts/checkBackupPrerequisites.js",
    "import-corrections:backfill": "node --env-file=.env scripts/backfillImportCorrectionEmbeddings.js",
    "seed:recipes": "node --env-file=.env scripts/seed-mfds-recipes.js",
    "recipes:export-public": "node --env-file=.env scripts/export-public-recipes.js",
    "validate:recipe-datasets": "node --env-file=.env scripts/validate-recipe-datasets.js",
    "parse:recipe-ingredients": "node --env-file=.env scripts/parse-recipe-ingredients.js",
    "recipes:embed": "node --env-file=.env scripts/embed-recipes.js",
    "recipes:checkpoint": "node --env-file=.env scripts/checkpoint-recipe-embeddings.js",
    "recipes:verify-embeddings": "node --env-file=.env scripts/verify-recipe-embeddings.js",
    "export:recipe-parser-training": "node --env-file=.env scripts/export-recipe-parser-training.js",
    "export:recommendation-training": "node --env-file=.env scripts/export-recommendation-training.js",
    "events:prune-retention": "node --env-file=.env scripts/pruneEventRetention.js",
    "ingredients:scrub-tombstones": "node --env-file=.env scripts/scrubIngredientTombstones.js",
    "label:recipe-parser-training": "node scripts/label-review.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^6.19.3",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "redis": "^6.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
